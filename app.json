{
  "expo": {
    "name": "Aurix",
    "slug": "NOTE",
    "version": "17.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.sanyamjain04.NOTE",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FA2D55",
          "defaultChannel": "daily"
        }
      ],
      "./plugins/withCoreLibraryDesugaring",
      "./plugins/withAndroidAbis",
      "./plugins/withReleaseSigning"
    ],
    "backgroundColor": "#000000",
    "extra": {
      "eas": {
        "projectId": "65a8b803-c802-43fc-b6a0-b2ea958ae534"
      },
      "supabaseFunctionsUrl": "https://gvjmhlwkunsqoimxjssn.supabase.co/functions/v1",
      "pushRegistrationEnabled": false
    }
  }
}
